#include <tunables/global>

# =============================================================================
# AppArmor Profile for BGE-M3 Embedding Service
# =============================================================================
# Restricts file system access and capabilities for additional security
# Installation: sudo apparmor_parser -r -W /path/to/apparmor-profile
# Usage: docker run --security-opt apparmor=bge-m3-embedding ...
# =============================================================================

profile bge-m3-embedding flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # ==========================================================================
  # Network Access
  # ==========================================================================
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,

  # ==========================================================================
  # Capabilities (minimal set)
  # ==========================================================================
  # capability net_bind_service,  # Uncomment if binding to port < 1024
  capability setuid,
  capability setgid,

  # Deny dangerous capabilities
  deny capability sys_admin,
  deny capability sys_module,
  deny capability sys_rawio,
  deny capability sys_ptrace,
  deny capability sys_boot,
  deny capability sys_time,
  deny capability mac_admin,
  deny capability mac_override,

  # ==========================================================================
  # File System Access
  # ==========================================================================

  # Allow read access to system libraries and Python
  /usr/bin/python3* rix,
  /usr/local/bin/python* rix,
  /usr/lib/** r,
  /usr/local/lib/** r,
  /lib/** r,
  /lib64/** r,

  # Application directory (read-only)
  /app/** r,

  # Models directory (read-only)
  /models/** r,

  # Temporary files (read-write)
  /tmp/** rw,
  /var/tmp/** rw,
  owner /tmp/** rw,
  owner /var/tmp/** rw,

  # Python bytecode cache (if needed)
  /app/__pycache__/** rw,
  /usr/local/lib/python*/site-packages/__pycache__/** rw,

  # Proc and sys (minimal read access)
  /proc/*/stat r,
  /proc/*/status r,
  /proc/*/cmdline r,
  /proc/sys/kernel/random/uuid r,
  /proc/cpuinfo r,
  /proc/meminfo r,
  /sys/devices/system/cpu/** r,

  # Dev (minimal)
  /dev/null rw,
  /dev/zero r,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/pts/* rw,

  # Deny access to sensitive system files
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /root/** rwx,
  deny /home/** rwx,
  deny /boot/** rwx,
  deny /sys/** w,

  # Deny execution of binaries (except Python)
  deny /bin/** x,
  deny /sbin/** x,
  deny /usr/sbin/** x,
  deny /usr/bin/** x,

  # Allow only Python execution
  /usr/bin/python3* ix,
  /usr/local/bin/python* ix,

  # ==========================================================================
  # Signal and Process Control
  # ==========================================================================
  signal (send) set=(term, kill),
  signal (receive) set=(term, kill, hup, int),

  # ==========================================================================
  # PTRACE Restrictions
  # ==========================================================================
  deny ptrace,

  # ==========================================================================
  # Mount Operations (deny all)
  # ==========================================================================
  deny mount,
  deny remount,
  deny umount,
  deny pivotroot,

  # ==========================================================================
  # DBus (deny - not needed for embedding service)
  # ==========================================================================
  deny dbus,

  # ==========================================================================
  # Special Files
  # ==========================================================================
  # Allow reading from standard file descriptors
  /proc/*/fd/** rw,

  # ==========================================================================
  # Additional Restrictions
  # ==========================================================================

  # Prevent modification of the AppArmor profile
  deny /sys/kernel/security/apparmor/** w,

  # Prevent loading kernel modules
  deny /lib/modules/** w,
  deny @{PROC}/sys/kernel/modules_disabled w,

  # Prevent changing system time
  deny @{PROC}/sys/kernel/time* w,

  # Prevent access to kernel ring buffer
  deny /dev/kmsg r,

  # ==========================================================================
  # Python-specific
  # ==========================================================================

  # Allow Python to read its configuration
  /etc/python*/** r,
  /usr/local/lib/python*/site-packages/** r,

  # Allow reading certificates for HTTPS (if needed)
  /etc/ssl/certs/** r,
  /usr/share/ca-certificates/** r,

  # ==========================================================================
  # Logging (if needed)
  # ==========================================================================
  # /var/log/bge-m3/** rw,

  # ==========================================================================
  # Notes
  # ==========================================================================
  # This profile is designed to be restrictive while allowing the BGE-M3
  # embedding service to function correctly. It denies:
  # - Most system capabilities
  # - Execution of binaries (except Python)
  # - Access to sensitive system files
  # - Module loading and system modification
  # - Debugging and tracing operations
  #
  # To install:
  #   sudo cp apparmor-profile /etc/apparmor.d/bge-m3-embedding
  #   sudo apparmor_parser -r -W /etc/apparmor.d/bge-m3-embedding
  #
  # To verify:
  #   sudo aa-status | grep bge-m3-embedding
  #
  # To use with Docker:
  #   docker run --security-opt apparmor=bge-m3-embedding ...
  # ==========================================================================
}
