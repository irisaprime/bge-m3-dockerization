# =============================================================================
# BGE-M3 Embedding Service - Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment
# DO NOT commit .env to version control
# =============================================================================

# =============================================================================
# Security Configuration
# =============================================================================

# API Key for authentication (REQUIRED - change in production!)
API_KEY=CHANGE_ME_TO_SECURE_RANDOM_KEY

# Enable/disable API key authentication
API_KEY_ENABLED=true

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# CORS origins (comma-separated, leave empty for no CORS)
CORS_ORIGINS=

# Disable API documentation in production
DISABLE_DOCS=false

# =============================================================================
# Model Configuration
# =============================================================================

# Use ONNX-optimized model for better CPU performance
USE_ONNX=true

# Maximum sequence length (tokens)
MAX_SEQ_LENGTH=8192

# Maximum batch size for processing
MAX_BATCH_SIZE=32

# Number of worker processes
MAX_WORKERS=4

# =============================================================================
# Deployment Configuration
# =============================================================================

# Environment name
ENVIRONMENT=production

# Host port mapping
HOST_PORT=8000

# =============================================================================
# Resource Limits
# =============================================================================

# CPU limits (cores)
CPU_LIMIT=4.0
CPU_RESERVATION=2.0

# Memory limits
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G

# =============================================================================
# Security Notes
# =============================================================================
# 1. Generate secure API key:
#    openssl rand -base64 32
#
# 2. For production, use Docker secrets or external secret management
#
# 3. Review and adjust resource limits based on your workload
#
# 4. Consider using environment-specific .env files:
#    .env.production, .env.staging, .env.development
# =============================================================================
